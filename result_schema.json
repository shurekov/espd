{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "document_type": {
      "type": "string",
      "minLength": 1
    },
    "standard": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rule_id": {
            "type": "string",
            "enum": [
              "VED-01",
              "VED-02",
              "VED-03",
              "VED-04",
              "VED-05",
              "VED-06"
            ]
          },
          "observation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "review"
            ]
          },
          "comment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "rule_id",
          "observation",
          "status",
          "comment",
          "evidence"
        ]
      }
    }
  },
  "required": [
    "document_type",
    "standard",
    "checks"
  ]
}